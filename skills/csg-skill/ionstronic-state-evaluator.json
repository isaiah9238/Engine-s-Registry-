{
  "id": "iontronic-state-evaluator",
  "name": "iontronic-state-evaluator",
  "title": "Iontronic State & Memory Telemetry Evaluator",
  "description": "Evaluates ECRAM and polymer channel conductance in mS (G = I/V), measures synaptic weight shifts, and estimates ion diffusion half-life.",
  "category": "telemetry-and-sensing",
  "version": "1.0.0",
  "status": "published",
  "isPublic": true,
  "securityClearance": "public",
  "isExecutable": true,
  "runtime": "in_process",
  "tags": [
    "iontronics",
    "ECRAM",
    "conductance-sensing",
    "synaptic-weight"
  ],
  "priority": 2,
  "thermodynamicFootprint": "low",
  "requiresHumanReview": false,
  "integrityManifest": {
    "algorithm": "SHA-256",
    "sha256": "51acc9c863998a55582e2e8d4121a9dce7cddeb13aab4de74a5ecb4ced80d069",
    "bytes": 4868
  },
  "parametersSchema": {
    "type": "object",
    "properties": {
      "channelId": {
        "type": "string",
        "description": "Target iontronic memory channel or array sector ID."
      },
      "readVoltageVolts": {
        "type": "number",
        "description": "Small non-destructive read pulse voltage in Volts."
      },
      "measuredCurrentAmps": {
        "type": "number",
        "description": "Measured channel read current in Amperes."
      },
      "baselineConductanceMs": {
        "type": "number",
        "description": "Calibrated baseline conductance in mS."
      },
      "activeIonSpecies": {
        "type": "string",
        "enum": [
          "Ca2+",
          "H+",
          "Li+",
          "PEDOT:PSS_redox"
        ],
        "default": "Ca2+",
        "description": "Dominant ion carrier species."
      },
      "samplingFrequencyHz": {
        "type": "number",
        "default": 100,
        "description": "Sensor sampling rate in Hertz."
      }
    },
    "required": [
      "channelId",
      "readVoltageVolts",
      "measuredCurrentAmps",
      "baselineConductanceMs"
    ]
  },
